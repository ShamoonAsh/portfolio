# Copy to .env.local for `vercel dev` (never commit the real file).
# In production these live in Vercel → Settings → Environment Variables.

# --- contact form ---
RESEND_API_KEY=re_xxxxxxxx
CONTACT_TO=
CONTACT_FROM=

# --- admin login ---
# Quote values containing # (otherwise the rest of the line is a comment).
ADMIN_USERNAME=
ADMIN_PASSWORD=""
# 32+ random characters, e.g. from: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# --- Upstash Redis (added automatically by the Vercel ↔ Upstash integration;
#     `vercel env pull .env.local` copies them down for local dev) ---
KV_REST_API_URL=https://xxxxxxxx.upstash.io
KV_REST_API_TOKEN=
